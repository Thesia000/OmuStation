<ui:FancyWindow xmlns="https://spacestation14.io"
                xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                VerticalExpand="True" HorizontalExpand="True"
                Title="{Loc admin-remarks-title}"
                SetSize="600 400">
    <PanelContainer StyleClasses="BackgroundDark">
        <BoxContainer Orientation="Vertical" SeparationOverride="4" MinWidth="150">
            <SpinBox Name="Name" HorizontalExpand="True"/>
            <Label Text="{Loc 'dish-control-angle'}"/>
            <LineEdit Name="PanelRotation" HorizontalExpand="True"/><Label Text="{Loc 'dish-control-window-degrees'}"/>
        </BoxContainer>
    </PanelContainer>
</ui:FancyWindow>
